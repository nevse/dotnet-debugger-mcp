<Project>
  <PropertyGroup>
    <!-- Common compilation settings -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Build output -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- The debugger, https://github.com/JaneySprings/clrdbg, taken from one release: it publishes no
         package, but every release carries the adapter and the remote CoreCLR libraries as zips.
         Both come from the same version, since the remote libraries speak a protocol the adapter has
         to match, and each is pinned by its hash. CI also checks both against the build provenance
         clrdbg attests for them. Bump the version and both hashes together.

         clrdbg_universal.zip is the adapter, framework-dependent and RID-agnostic: runtimes/*/native
         carries libdbgshim for every platform at once, the same shape this server ships as.
         RemoteCoreClrLibraries.zip is taken rather than built for its own reason: the host half is
         NativeAOT for six RIDs and the target half needs Xcode and the Android NDK. -->
    <ClrdbgVersion>18.1.0</ClrdbgVersion>
    <ClrdbgAdapterUrl>https://github.com/JaneySprings/clrdbg/releases/download/$(ClrdbgVersion)/clrdbg_universal.zip</ClrdbgAdapterUrl>
    <ClrdbgAdapterSha256>d5563dc30ee6d65fb14e0422708fad3214d699fe82d640f29680a9d50d8650df</ClrdbgAdapterSha256>
    <RemoteCoreclrLibrariesUrl>https://github.com/JaneySprings/clrdbg/releases/download/$(ClrdbgVersion)/RemoteCoreClrLibraries.zip</RemoteCoreclrLibrariesUrl>
    <RemoteCoreclrLibrariesSha256>03001c64fd5a6df23028e340301026dd9b1319618521e9cf5a01ab805c055ee9</RemoteCoreclrLibrariesSha256>

    <!-- Fixes to the debugger are made in a clone of our fork, and this builds the adapter from it
         instead of taking the release's - as an environment variable, so it applies to every command
         in a shell rather than being repeated on each one:
           export ClrdbgSourcePath=/path/to/clrdbg
         or for one command:
           dotnet build -p:ClrdbgSourcePath=/path/to/clrdbg
         The remote libraries still come from ClrdbgVersion, so the clone has to speak their
         protocol. Unset, the build uses the release alone. -->

    <!-- Repository and package metadata -->
    <Authors>.NET Debugger MCP Contributors</Authors>
    <Copyright>Copyright © 2026 .NET Debugger MCP Contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/nevse/dotnet-debugger-mcp</RepositoryUrl>
    <PackageProjectUrl>https://github.com/nevse/dotnet-debugger-mcp</PackageProjectUrl>
  </PropertyGroup>
</Project>
