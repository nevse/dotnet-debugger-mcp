<Project>
  <PropertyGroup>
    <!-- Common compilation settings -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Build output -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- The debugger, https://github.com/JaneySprings/clrdbg, referenced as source: it publishes no
         package, so there is nothing to restore and the checkout is the dependency.

         The default is the submodule, which tracks upstream and is what CI builds. Fixes to the
         debugger are made in a clone of our fork instead, and this switches the build over to it -
         as an environment variable, so it applies to every command in a shell rather than being
         repeated on each one:
           export ClrdbgSourcePath=/Users/nevse/work/projects/clrdbg
         or for one command:
           dotnet build -p:ClrdbgSourcePath=/path/to/clrdbg
         Unset, everything builds against the pinned submodule. -->
    <ClrdbgSourcePath Condition="'$(ClrdbgSourcePath)' == ''">$(MSBuildThisFileDirectory)external/clrdbg</ClrdbgSourcePath>

    <!-- The remote CoreCLR debugging libraries for mobile apps, taken from a clrdbg release rather
         than built: the host half is NativeAOT for six RIDs and the target half needs Xcode and the
         Android NDK, which no ordinary build of this repository has. Pinned by version and by hash,
         and kept to the release the submodule is at, since the two halves speak a protocol the
         adapter has to match. Bump all three together with the submodule. -->
    <RemoteCoreclrLibrariesVersion>18.0.0</RemoteCoreclrLibrariesVersion>
    <RemoteCoreclrLibrariesUrl>https://github.com/JaneySprings/clrdbg/releases/download/$(RemoteCoreclrLibrariesVersion)/RemoteCoreClrLibraries.zip</RemoteCoreclrLibrariesUrl>
    <RemoteCoreclrLibrariesSha256>25084a12dba52b4a94de1db07354326a5bbed285f4cea50e7566cdb13c810f58</RemoteCoreclrLibrariesSha256>

    <!-- Repository and package metadata -->
    <Authors>SharpDbg MCP Contributors</Authors>
    <Copyright>Copyright © 2026 SharpDbg MCP Contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/nevse/dotnet-debugger-mcp</RepositoryUrl>
    <PackageProjectUrl>https://github.com/nevse/dotnet-debugger-mcp</PackageProjectUrl>
  </PropertyGroup>
</Project>
